{
  "name": "smart-imaging-proxy",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "up": "bun install --frozen-lockfile && bun scripts/up.ts",
    "down": "bun scripts/down.ts",
    "fetch-data": "bun scripts/fetch-data.ts",
    "generate-synthetic": "bun scripts/generate-synthetic.ts",
    "ingest": "bun scripts/ingest.ts",
    "load": "bun scripts/load-backends.ts",
    "build-catalog": "bun scripts/build-catalog.ts",
    "catalog-from-orthanc": "bun scripts/catalog-from-orthanc.ts",
    "viewer-kit": "bun scripts/viewer-kit.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "test:ui": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3000} bun test ./e2e/browser.e2e.ts",
    "dev": "DEMO_TAILNET=0 bun --watch src/main.ts",
    "test:client": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3000} bun test ./e2e/client.e2e.ts",
    "minikube": "deploy/minikube.sh"
  },
  "devDependencies": {
    "@types/react": "19",
    "@types/react-dom": "19",
    "playwright-core": "^1.65.0",
    "typescript": "5"
  },
  "dependencies": {
    "@smart-imaging-proxy/core": "workspace:*",
    "react": "19",
    "react-dom": "19",
    "react-router": "7"
  }
}
