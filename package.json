{
  "name": "smart-imaging-proxy",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "up": "bun install --frozen-lockfile && bun scripts/up.ts",
    "down": "bun scripts/down.ts",
    "fetch-data": "bun scripts/fetch-data.ts",
    "generate-synthetic": "bun scripts/generate-synthetic.ts",
    "ingest": "bun scripts/ingest.ts",
    "load": "bun scripts/load-backends.ts",
    "build-catalog": "bun scripts/build-catalog.ts",
    "catalog-from-orthanc": "bun scripts/catalog-from-orthanc.ts",
    "viewer-kit": "bun scripts/viewer-kit.ts",
    "start": "bun src/main.ts",
    "test": "BACKENDS=${BACKENDS:-static-files} bun test",
    "test:unit": "bun test packages/core/tests/units.test.ts packages/core/tests/boundary.test.ts packages/core/tests/events.test.ts packages/core/tests/instances.test.ts packages/core/tests/policy-api.test.ts packages/core/tests/policy-bands.test.ts packages/core/tests/policy-rows.test.ts packages/core/tests/policy-store.test.ts packages/core/tests/policy-union.test.ts tests/activity.test.ts tests/clinical.test.ts tests/viewer-jwks.test.ts tests/proxy-trace.test.ts",
    "test:parallel": "BACKENDS=${BACKENDS:-static-files} bun test --parallel",
    "test:matrix": "BACKENDS=static-files,s3,orthanc bun test --parallel",
    "test:ui": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3100} bun test ./e2e/browser.e2e.ts",
    "test:spec": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3200} bun test ./e2e/spec.e2e.ts",
    "test:drive": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3300} bun test ./e2e/drive.e2e.ts",
    "test:layout": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3400} bun test ./e2e/layout.e2e.ts",
    "test:app-check": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3500} bun test ./e2e/app-check.e2e.ts",
    "test:e2e": "bun run test:client && bun run test:ui && bun run test:spec && bun run test:drive && bun run test:layout && bun run test:app-check",
    "dev": "DEMO_TAILNET=0 bun --watch src/main.ts",
    "test:client": "DEMO_PORT_OFFSET=${DEMO_PORT_OFFSET:-3000} bun test ./e2e/client.e2e.ts",
    "minikube": "deploy/minikube.sh"
  },
  "devDependencies": {
    "@types/react": "19",
    "@types/react-dom": "19",
    "playwright-core": "^1.65.0",
    "typescript": "5"
  },
  "dependencies": {
    "@smart-imaging-proxy/core": "workspace:*",
    "react": "19",
    "react-dom": "19",
    "react-router": "7"
  }
}
